<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SteamAppId Condition="'$(SteamAppId)' == ''">480</SteamAppId>
    <GenerateSteamAppIdFile Condition="'$(GenerateSteamAppIdFile)' == '' and '$(SteamDepotBuild)' != 'true'">true</GenerateSteamAppIdFile>
    <GenerateSteamAppIdFile Condition="'$(GenerateSteamAppIdFile)' == ''">false</GenerateSteamAppIdFile>
  </PropertyGroup>
</Project>
