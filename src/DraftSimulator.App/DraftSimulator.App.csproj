<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DraftSimulator.Core\DraftSimulator.Core.csproj" />
    <ProjectReference Include="..\DraftSimulator.Protocol\DraftSimulator.Protocol.csproj" />
    <ProjectReference Include="..\DraftSimulator.Infrastructure\DraftSimulator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\Steamworks.NET\steam_api64.dll" Link="steam_api64.dll" Condition="'$(OfflineDebugArtifact)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SteamAppId Condition="'$(SteamAppId)' == ''">480</SteamAppId>
    <DefineConstants Condition="'$(OfflineDebugArtifact)' == 'true'">$(DefineConstants);OFFLINE_DEBUG_ARTIFACT</DefineConstants>
    <AssemblyName Condition="'$(OfflineDebugArtifact)' == 'true'">DraftSimulator.Debug</AssemblyName>
  </PropertyGroup>

  <Target Name="ValidateSteamPublishContent" AfterTargets="WritePublishedSteamAppIdFile" Condition="'$(GenerateSteamAppIdFile)' == 'true'">
    <Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) and !Exists('$(PublishDir)$(AssemblyName).exe')" Text="Published Windows executable is missing." />
    <Error Condition="!Exists('$(PublishDir)steam_api64.dll')" Text="Published Steam API DLL is missing." />
    <Error Condition="!Exists('$(PublishDir)steam_appid.txt')" Text="Published Steam AppID file is missing." />
  </Target>

</Project>
