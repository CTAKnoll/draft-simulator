<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DraftSimulator.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#D5FF47" />
      <Setter Property="Foreground" Value="#10120B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#171A18" />
      <Setter Property="BorderBrush" Value="#323832" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#D5FF47" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="Button.card">
      <Setter Property="Background" Value="#171A18" />
      <Setter Property="BorderBrush" Value="#323832" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.card.selected">
      <Setter Property="BorderBrush" Value="#D5FF47" />
      <Setter Property="Background" Value="#253016" />
    </Style>
  </Application.Styles>
</Application>
